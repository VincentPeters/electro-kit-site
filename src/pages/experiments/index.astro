---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ExperimentCard from '../../components/ExperimentCard.astro';
import { url } from '../../lib/url';
import { sortByNumber } from '../../lib/experiments';

const chapters = (await getCollection('chapters')).sort(
  (a, b) => a.data.order - b.data.order,
);
const experiments = await getCollection('experiments');
---

<BaseLayout
  title="All experiments"
  description="Every one of the 60 experiments in the Easy Elektro Start kit, grouped by chapter."
>
  <h1>All 60 experiments</h1>
  <p>
    Every experiment in the kit, in the order the manual runs them. They build
    on each other, so working straight through is the easiest way.
  </p>

  {
    chapters.map((chapter) => (
      <section data-theme={chapter.data.colour}>
        <h2>
          <a href={url(`/chapters/${chapter.id}/`)}>{chapter.data.title}</a>
        </h2>
        <div class="cards">
          {sortByNumber(
            experiments.filter((e) => e.data.chapter.id === chapter.id),
          ).map((exp) => (
            <ExperimentCard id={exp.id} number={exp.data.number} title={exp.data.title} />
          ))}
        </div>
      </section>
    ))
  }
</BaseLayout>

<style>
  section {
    margin-block: 2.5rem;
  }
  section h2 a {
    color: var(--theme);
    text-decoration: none;
  }
  section h2 a:hover {
    text-decoration: underline;
  }
  .cards {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
  }
</style>
