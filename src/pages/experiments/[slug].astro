---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Board from '../../components/Board.astro';
import ThreadLine, { type ConceptRef } from '../../components/ThreadLine.astro';
import { url } from '../../lib/url';
import { experimentSlug, sortByNumber } from '../../lib/experiments';
import { whereYouMeetIt } from '../../lib/concepts';

export async function getStaticPaths() {
  const all = sortByNumber(await getCollection('experiments'));

  return all.map((experiment, index) => ({
    params: { slug: experimentSlug(experiment.id) },
    props: {
      experiment,
      previous: all[index - 1] ?? null,
      next: all[index + 1] ?? null,
    },
  }));
}

const { experiment, previous, next } = Astro.props;
const chapter = await getEntry(experiment.data.chapter);
const { number, title, steps, whatHappens, eli5, note, sidebar, tables, boards } = experiment.data;

const concepts = await getCollection('concepts');
const allExperiments = await getCollection('experiments');
const byId = new Map(concepts.map((c) => [c.id, c]));

const toRef = (id: string): ConceptRef | null => {
  const concept = byId.get(id);
  if (!concept) return null;
  const { introducedBy } = whereYouMeetIt(id, allExperiments);
  return {
    id,
    name: concept.data.name,
    introducedIn: introducedBy?.data.number ?? null,
  };
};

const introducesRefs = experiment.data.introduces.map(toRef).filter((c) => c !== null);
const practisesRefs = experiment.data.practises.map(toRef).filter((c) => c !== null);
---

<BaseLayout title={title} description={whatHappens[0]} theme={chapter!.data.colour}>
  <div class="band" slot="band">
    <div class="wrap">
      <span class="hex">{number}</span>
      <div class="band-text">
        <p class="chip">
          <a href={url(`/chapters/${chapter!.id}/`)}>{chapter!.data.title}</a>
        </p>
        <h1>{title}</h1>
      </div>
    </div>
  </div>

  <ThreadLine introduces={introducesRefs} practises={practisesRefs} />

  <div class="sheet">
    <div class="plates">
      {boards.map((board) => (
        <Board parts={board.parts} caption={board.caption} noBattery={board.noBattery} />
      ))}
    </div>

    <div class="build">
      <h2>Build it</h2>
      <ol class="ladder">
        {steps.map((step, i) => (
          <li class="step">
            <span class="hex">{i + 1}</span>
            <span>{step}</span>
          </li>
        ))}
      </ol>
      {note && <p class="note">{note}</p>}
    </div>
  </div>

  <div class:list={['explain-row', { 'has-sidebar': sidebar }]}>
    <section class="explain">
      <h2>What happens?</h2>
      {whatHappens.map((para) => <p>{para}</p>)}
      {
        eli5 && (
          <details class="simpler">
            <summary>Say that in simpler words</summary>
            {eli5.map((para) => <p>{para}</p>)}
          </details>
        )
      }
    </section>

    {
      sidebar && (
        <aside class="sidebar">
          <h2>{sidebar.heading}</h2>
          {sidebar.body.map((para) => (
            <p>{para}</p>
          ))}
        </aside>
      )
    }
  </div>

  {
    tables.length > 0 && (
      <div class="tables">
        {tables.map((table) => (
          <section class="table-block">
            <h2>{table.heading}</h2>
            <table>
              <thead>
                <tr>
                  {table.columns.map((column) => (
                    <th scope="col">{column}</th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {table.rows.map((row) => (
                  <tr>
                    {row.map((cell, i) =>
                      i === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>,
                    )}
                  </tr>
                ))}
              </tbody>
            </table>
          </section>
        ))}
      </div>
    )
  }

  <nav class="pager" aria-label="Experiments">
    {
      previous ? (
        <a href={url(`/experiments/${experimentSlug(previous.id)}/`)}>
          <span class="dir">← Previous</span>
          <span class="name">
            {previous.data.number}. {previous.data.title}
          </span>
        </a>
      ) : (
        <span />
      )
    }
    {
      next && (
        <a class="next" href={url(`/experiments/${experimentSlug(next.id)}/`)}>
          <span class="dir">Next →</span>
          <span class="name">
            {next.data.number}. {next.data.title}
          </span>
        </a>
      )
    }
  </nav>
</BaseLayout>

<style>
  /*
    Build sheet. The circuit comes first in the source so a child on a phone
    sees what they are making before the instructions for making it; on a wide
    screen the plates move to the right and stay put while the steps scroll.
  */
  .sheet {
    display: grid;
    gap: var(--space-m);
    grid-template-columns: minmax(0, 1fr);
  }
  .plates {
    display: grid;
    gap: var(--space);
  }
  .build h2 {
    margin-top: var(--space-m);
  }

  @media (min-width: 62rem) {
    .sheet {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
      gap: var(--space-l);
      align-items: start;
    }
    .plates {
      grid-column: 2;
      grid-row: 1;
      position: sticky;
      top: var(--space);
      /* Experiments with three build plans are taller than the viewport. */
      max-height: calc(100vh - var(--space) * 2);
      overflow-y: auto;
    }
    .build {
      grid-column: 1;
      grid-row: 1;
    }
    .build h2 {
      margin-top: 0;
    }
  }

  .ladder {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--colour-line);
  }
  .step {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space);
    align-items: start;
    padding-block: 0.9rem;
    border-bottom: 1px solid var(--colour-line);
    max-width: none;
    line-height: 1.5;
  }
  /*
    Graphite, not the chapter colour: a red marker beside a diagram where red
    means "uses the current" would break the code the whole site depends on.
  */
  .step .hex {
    background: var(--colour-ink-strong);
  }

  .note {
    margin-top: var(--space-m);
    padding: var(--space) var(--space-m);
    background: var(--theme-wash);
    border: 1px solid var(--theme-edge);
    border-radius: var(--radius-l);
    font-weight: 600;
    max-width: none;
  }

  .explain-row {
    display: grid;
    gap: var(--space-m);
    grid-template-columns: minmax(0, 1fr);
    margin-top: var(--space-xl);
    align-items: stretch;
  }
  @media (min-width: 62rem) {
    .explain-row.has-sidebar {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    }
  }
  .explain h2,
  .sidebar h2 {
    margin-top: 0;
    font-size: var(--step-1);
  }
  .explain {
    padding: var(--space-m) var(--space-l);
    background: var(--colour-surface);
    border-radius: var(--radius-l);
  }
  .explain p:last-child {
    margin-bottom: 0;
  }
  .simpler {
    margin-top: var(--space-m);
    padding-top: var(--space);
    border-top: 1px solid var(--colour-line);
  }
  .simpler summary {
    font-weight: 700;
    color: var(--colour-ink-strong);
    cursor: pointer;
  }
  .simpler p {
    margin-bottom: var(--space-xs);
  }
  .simpler p:last-child {
    margin-bottom: 0;
  }
  .sidebar {
    padding: var(--space-m) var(--space-l);
    border: 1px solid var(--colour-line-strong);
    border-radius: var(--radius-l);
  }
  .sidebar h2 {
    padding-bottom: var(--space-xs);
    border-bottom: 2px solid var(--colour-ink-strong);
  }
  .sidebar p:last-child {
    margin-bottom: 0;
  }

  .tables {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-l) var(--space-xl);
    margin-top: var(--space-xl);
  }
  .table-block h2 {
    margin-top: 0;
    font-size: var(--step-1);
  }
  .tables table {
    border-collapse: collapse;
  }
  .tables th,
  .tables td {
    padding: 0.3rem 1.5rem 0.3rem 0;
    text-align: left;
  }
  .tables thead th {
    border-bottom: 2px solid var(--colour-ink-strong);
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--colour-muted);
  }
  .tables tbody th {
    font-weight: 700;
  }
  .tables tbody tr + tr th,
  .tables tbody tr + tr td {
    border-top: 1px solid var(--colour-line);
  }
  .tables td {
    font-size: 1.2em;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.1em;
  }

  .pager {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space);
    margin-top: var(--space-2xl);
    padding-top: var(--space-m);
    border-top: 2px solid var(--colour-ink-strong);
  }
  .pager a {
    display: grid;
    gap: 0.15rem;
    text-decoration: none;
    color: var(--colour-ink-strong);
  }
  .pager .next {
    text-align: right;
  }
  .pager .dir {
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--colour-muted);
  }
  .pager .name {
    font-weight: 700;
    line-height: 1.3;
  }
  .pager a:hover .name {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }
</style>
