---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ExperimentCard from '../../components/ExperimentCard.astro';
import { sortByNumber } from '../../lib/experiments';

export async function getStaticPaths() {
  const chapters = await getCollection('chapters');
  const experiments = await getCollection('experiments');

  return chapters.map((chapter) => ({
    params: { slug: chapter.id },
    props: {
      chapter,
      experiments: sortByNumber(
        experiments.filter((e) => e.data.chapter.id === chapter.id),
      ),
    },
  }));
}

const { chapter, experiments } = Astro.props;
const [opening, ...rest] = chapter.data.intro;
---

<BaseLayout
  title={chapter.data.title}
  description={chapter.data.intro[0]}
  theme={chapter.data.colour}
>
  <div class="band" slot="band">
    <div class="wrap">
      <span class="hex">{chapter.data.order}</span>
      <div class="band-text">
        <p class="chip">Chapter {chapter.data.order} · {experiments.length} experiments</p>
        <h1>{chapter.data.title}</h1>
      </div>
    </div>
  </div>

  <div class="intro">
    <p class="lede">{opening}</p>
    {rest.map((para) => <p>{para}</p>)}
  </div>

  <h2>Experiments {experiments[0]?.data.number}–{experiments.at(-1)?.data.number}</h2>
  <div class="cards">
    {
      experiments.map((exp) => (
        <ExperimentCard id={exp.id} number={exp.data.number} title={exp.data.title} />
      ))
    }
  </div>

  {
    chapter.data.deepDive.length > 0 && (
      <section class="deep-dive">
        <h2>A closer look</h2>
        <div class="entries">
          {chapter.data.deepDive.map((entry) => (
            <div class="entry">
              <h3>{entry.heading}</h3>
              {entry.body.map((para) => (
                <p>{para}</p>
              ))}
            </div>
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .intro {
    max-width: 44rem;
  }
  .lede {
    font-size: var(--step-1);
    font-weight: 500;
    line-height: 1.4;
    max-width: 34ch;
    text-wrap: balance;
  }
  .intro p + p {
    max-width: 44rem;
  }
  .cards {
    display: grid;
    gap: 0.6rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
  }
  .deep-dive {
    margin-top: var(--space-2xl);
    padding-top: var(--space-m);
    border-top: 2px solid var(--colour-ink-strong);
  }
  .deep-dive h2 {
    margin-top: 0;
  }
  .entries {
    display: grid;
    gap: var(--space-l);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 26rem), 1fr));
    align-items: start;
  }
  .entry h3 {
    margin-top: 0;
    color: var(--theme);
  }
  .entry p:last-child {
    margin-bottom: 0;
  }
</style>
