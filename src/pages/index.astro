---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ChapterCard from '../components/ChapterCard.astro';
import Board from '../components/Board.astro';
import { url } from '../lib/url';
import type { PlacedPart } from '../board/describe';

const chapters = (await getCollection('chapters')).sort(
  (a, b) => a.data.order - b.data.order,
);
const experiments = await getCollection('experiments');
const countFor = (slug: string) =>
  experiments.filter((e) => e.data.chapter.id === slug).length;

// The very first circuit in the book, as a taste of what a build plan looks like.
const firstCircuit: PlacedPart[] = [
  { type: 'lamp', from: 'D2', to: 'D3', level: 1 },
  { type: 'link3', from: 'D3', to: 'F3', level: 1 },
  { type: 'link2', from: 'F2', to: 'F3', level: 2 },
];

const howItWorks = [
  {
    heading: 'Look at the plan',
    body: 'A drawing of the finished circuit, on the same grid as the baseplate in front of you. Every part sits where it sits on the board.',
  },
  {
    heading: 'Build it and switch it on',
    body: 'Numbered steps, one clip at a time, bottom level first. Then press the switch and watch what the circuit does.',
  },
  {
    heading: 'Find out why',
    body: 'A plain explanation of what the electricity just did, and why swapping one part changes everything.',
  },
];
---

<BaseLayout
  title="Home"
  description="All 60 experiments from the KOSMOS Easy Elektro Start electronics kit, written in English."
>
  <section class="hero" slot="band">
    <div class="wrap">
      <div class="hero-text">
        <h1>Sixty circuits, one baseplate.</h1>
        <p>
          The whole KOSMOS Easy Elektro Start kit, written in English. Clip the
          parts together, switch it on, and find out what the electricity is
          actually doing in there.
        </p>
        <p class="actions">
          <a class="button" href={url('/experiments/going-round-in-circles/')}>
            Start at experiment 1
          </a>
          <a class="secondary" href={url('/build-tips/')}>How to read a build plan</a>
        </p>
      </div>
      <div class="hero-plate">
        <Board parts={firstCircuit} caption="Experiment 1: a bulb, and a complete loop" />
      </div>
    </div>
  </section>

  <section class="how">
    <h2>Every experiment, three parts</h2>
    <ol class="how-list">
      {
        howItWorks.map((item, i) => (
          <li>
            <span class="hex">{i + 1}</span>
            <h3>{item.heading}</h3>
            <p>{item.body}</p>
          </li>
        ))
      }
    </ol>
    <p class="how-note">
      New to the kit? Start with <a href={url('/parts/')}>what is in the box</a>,
      then learn <a href={url('/build-tips/')}>how to read a build plan</a>.
    </p>
  </section>

  <section class="chapters-section">
    <h2>The five chapters</h2>
    <div class="chapters">
      {
        chapters.map((chapter) => (
          <ChapterCard
            slug={chapter.id}
            order={chapter.data.order}
            title={chapter.data.title}
            blurb={chapter.data.intro[0]}
            colour={chapter.data.colour}
            count={countFor(chapter.id)}
          />
        ))
      }
    </div>
  </section>

  <section class="safety">
    <h2>Before you start</h2>
    <p class="safety-lede">
      The kit is for children of 8 and over, because the electrical parts are
      out in the open. It is not suitable for under-3s: there are small parts
      that could be swallowed or breathed in.
    </p>
    <ul class="rules">
      <li>
        <strong>Small magnets.</strong> Swallowed magnets can pull towards each
        other inside the body and cause serious injury. If that ever happens,
        see a doctor straight away.
      </li>
      <li>
        <strong>Never experiment with wall sockets.</strong> The 230 volts in
        the mains is lethal. This kit runs on 3 volts and nothing else.
      </li>
      <li>
        <strong>Never short-circuit the terminals.</strong> Joining the two
        battery terminals with nothing in between makes the wires hot and can
        make the batteries burst.
      </li>
      <li>
        <strong>Two AA batteries</strong> (LR6) are needed and are not included.
        Put them in the right way round, matching the plus and minus marks.
      </li>
      <li>
        <strong>Do not mix batteries.</strong> Old with new, or rechargeable
        with ordinary, is not safe. Ordinary batteries must never be charged.
        Rechargeables come out of the toy first and are charged by an adult.
      </li>
      <li>
        <strong>Take the batteries out</strong> when they are flat or when you
        have finished for the day, and do not bend or squash them.
      </li>
      <li>
        <strong>Leave the battery compartment alone.</strong> It has a built-in
        protection device, and tampering with it can cause overheating.
      </li>
      <li>
        <strong>Keep the spinning propeller</strong> away from faces, people and
        animals. It can fly five metres into the air.
      </li>
    </ul>
    <p class="parents">
      <strong>A note for parents:</strong> the rules above are a summary. The
      printed manual that came with the kit is the authority, and it is worth
      reading it with your child before the first experiment.
    </p>
  </section>
</BaseLayout>

<style>
  /*
    The dark field continues down from the masthead, so the page opens like a
    lit workbench: the baseplate is the only bright thing on it.
  */
  .hero {
    background: var(--colour-ink-strong);
    color: var(--colour-page);
    background-image: radial-gradient(
      circle at center,
      oklch(1 0 0 / 0.07) 1.5px,
      transparent 1.6px
    );
    background-size: 22px 22px;
  }
  .hero .wrap {
    display: grid;
    gap: var(--space-l);
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    padding-block: var(--space-xl) var(--space-2xl);
  }
  @media (min-width: 56rem) {
    .hero .wrap {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--space-2xl);
    }
  }
  .hero h1 {
    font-size: var(--step-4);
    color: var(--colour-page);
    letter-spacing: -0.03em;
    margin-bottom: var(--space);
  }
  .hero p {
    color: oklch(1 0 0 / 0.78);
    max-width: 38ch;
    line-height: 1.65;
  }
  .actions {
    max-width: none;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space) var(--space-m);
    margin-top: var(--space-m);
  }
  .actions .button {
    background: var(--colour-page);
    color: var(--colour-ink-strong);
  }
  .actions .button:hover {
    background: oklch(1 0 0);
  }
  .secondary {
    color: var(--colour-page);
    font-weight: 600;
    text-decoration-color: oklch(1 0 0 / 0.4);
  }
  .hero a:focus-visible {
    outline-color: var(--colour-page);
  }
  .hero-plate :global(.board) {
    border-color: oklch(1 0 0 / 0.14);
    box-shadow: 0 18px 40px -20px oklch(0 0 0 / 0.8);
  }

  /* ---- How it works ---- */

  .how-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-m);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
  }
  .how-list li {
    max-width: none;
    padding-top: var(--space-s);
    border-top: 2px solid var(--colour-ink-strong);
  }
  .how-list h3 {
    margin: var(--space-xs) 0 0.2rem;
    font-size: var(--step-1);
  }
  .how-list p {
    margin: 0;
    color: var(--colour-ink);
  }
  .how-note {
    margin-top: var(--space-m);
    color: var(--colour-muted);
  }

  .chapters-section {
    margin-top: var(--space-2xl);
  }
  .chapters {
    display: grid;
    gap: 0.6rem;
  }

  /* ---- Safety ---- */

  .safety {
    margin-top: var(--space-2xl);
    padding: var(--space-l);
    background: var(--colour-surface);
    border: 1px solid var(--colour-line);
    border-radius: var(--radius-l);
  }
  .safety h2 {
    margin-top: 0;
  }
  .safety-lede {
    font-weight: 600;
    max-width: 52ch;
  }
  .rules {
    list-style: none;
    margin: var(--space-m) 0 0;
    padding: 0;
    display: grid;
    gap: 0.8rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
  }
  .rules li {
    max-width: none;
    padding-left: var(--space-m);
    line-height: 1.5;
    position: relative;
  }
  /* A snap stud, the same mark the parts carry at every contact. */
  .rules li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    border: 2.5px solid var(--colour-ink-strong);
  }
  .parents {
    margin: var(--space-m) 0 0;
    padding-top: var(--space);
    border-top: 1px solid var(--colour-line);
    color: var(--colour-muted);
    max-width: 60ch;
  }
</style>
