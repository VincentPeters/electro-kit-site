---
import {
  BOARD_HEIGHT,
  BOARD_WIDTH,
  COLS,
  GUTTER_X,
  GUTTER_Y,
  PITCH_X,
  PITCH_Y,
  ROWS,
  cellCenter,
} from '../board/geometry';
import { describeBoard, type PlacedPart } from '../board/describe';
import { layoutLabels } from '../board/annotate';
import Part from './Part.astro';

interface Props {
  parts: PlacedPart[];
  caption?: string;
  /** Dim the battery when the experiment does not use it. */
  noBattery?: boolean;
}

const { parts, caption, noBattery = false } = Astro.props;

// Lower levels paint first so stacked parts sit on top, as they do in the kit.
const ordered = [...parts].sort((a, b) => (a.level ?? 1) - (b.level ?? 1));

const holes = ROWS.flatMap((row) =>
  Array.from({ length: COLS }, (_, i) => cellCenter(`${row}${i + 1}`)),
);

const hexPoints = (cx: number, cy: number, r: number) =>
  Array.from({ length: 6 }, (_, i) => {
    const angle = (Math.PI / 3) * i - Math.PI / 2;
    return `${(cx + r * Math.cos(angle)).toFixed(2)},${(cy + r * Math.sin(angle)).toFixed(2)}`;
  }).join(' ');

const batteryTopLeft = cellCenter('D1');
const battery = {
  x: batteryTopLeft.x - PITCH_X / 2,
  y: batteryTopLeft.y - PITCH_Y / 2,
  width: PITCH_X * 2,
  height: PITCH_Y * 3,
};

// The battery sits in column 1; its terminals are the column 2 holes that
// every build plan connects to.
const batteryCentre = { x: batteryTopLeft.x, y: battery.y + battery.height / 2 };
const minusTerminal = cellCenter('D2');
const plusTerminal = cellCenter('F2');

const description = describeBoard(parts);

// Labels are solved against every part at once, so a crowded plan pushes
// them apart instead of stacking them on top of each other.
const labels = layoutLabels(parts);
---

<figure class="board">
  <svg
    viewBox={`0 0 ${BOARD_WIDTH} ${BOARD_HEIGHT}`}
    role="img"
    aria-label={description}
    xmlns="http://www.w3.org/2000/svg"
  >
    <rect
      x={GUTTER_X - 12}
      y={GUTTER_Y - 12}
      width={BOARD_WIDTH - GUTTER_X + 4}
      height={BOARD_HEIGHT - GUTTER_Y + 4}
      rx="16"
      fill="#f3f5f8"
      stroke="#d7dde6"
      stroke-width="2"
    />

    {holes.map((hole) => (
      <polygon
        points={hexPoints(hole.x, hole.y, 20)}
        fill="#ffffff"
        stroke="#e2e7ee"
        stroke-width="2"
      />
    ))}

    <rect
      x={battery.x}
      y={battery.y}
      width={battery.width}
      height={battery.height}
      rx="12"
      fill="#e6eaf0"
      stroke="#cfd6e0"
      stroke-width="2"
    />
    {/*
      The battery symbol sits in column 1, and its two leads run out to the
      terminal holes in column 2 that build plans actually connect to, so the
      path from the battery into the circuit is visible rather than implied.
    */}
    <g class="battery" opacity={noBattery ? 0.25 : 1}>
      <path
        d={`M ${batteryCentre.x} ${batteryCentre.y - 22} V ${minusTerminal.y} H ${minusTerminal.x}`}
        fill="none"
        stroke="#d92b2b"
        stroke-width="5"
      />
      <path
        d={`M ${batteryCentre.x} ${batteryCentre.y + 14} V ${plusTerminal.y} H ${plusTerminal.x}`}
        fill="none"
        stroke="#d92b2b"
        stroke-width="5"
      />
      <circle cx={minusTerminal.x} cy={minusTerminal.y} r="9" fill="#d92b2b" />
      <circle cx={minusTerminal.x} cy={minusTerminal.y} r="4" fill="#ffffff" />
      <circle cx={plusTerminal.x} cy={plusTerminal.y} r="9" fill="#d92b2b" />
      <circle cx={plusTerminal.x} cy={plusTerminal.y} r="4" fill="#ffffff" />

      <g transform={`translate(${batteryCentre.x} ${batteryCentre.y})`}>
        <line x1="-18" y1="-22" x2="18" y2="-22" stroke="#d92b2b" stroke-width="5" />
        <line x1="-9" y1="-10" x2="9" y2="-10" stroke="#d92b2b" stroke-width="5" />
        <line x1="-18" y1="2" x2="18" y2="2" stroke="#d92b2b" stroke-width="5" />
        <line x1="-9" y1="14" x2="9" y2="14" stroke="#d92b2b" stroke-width="5" />
        <text x="-26" y="-18" text-anchor="middle" font-size="18" font-weight="700" fill="#d92b2b">
          &#8722;
        </text>
        <text x="-26" y="22" text-anchor="middle" font-size="18" font-weight="700" fill="#d92b2b">
          +
        </text>
        <text x="34" y="5" text-anchor="middle" font-size="13" font-weight="700" fill="#7b8797">
          3V
        </text>
      </g>
    </g>

    {Array.from({ length: COLS }, (_, i) => (
      <text
        x={GUTTER_X + i * PITCH_X + PITCH_X / 2}
        y={GUTTER_Y - 18}
        text-anchor="middle"
        font-size="18"
        font-weight="700"
        fill="#7b8797">{i + 1}</text>
    ))}

    {ROWS.map((row, i) => (
      <text
        x={GUTTER_X - 24}
        y={GUTTER_Y + i * PITCH_Y + PITCH_Y / 2 + 6}
        text-anchor="middle"
        font-size="18"
        font-weight="700"
        fill="#7b8797">{row}</text>
    ))}

    {ordered.map((part) => <Part part={part} />)}

    {/* Labels paint last so nothing is drawn over a number. */}
    {labels.map((label) => (
      <g>
        {label.leader && (
          <line
            x1={label.anchor.x}
            y1={label.anchor.y}
            x2={label.x}
            y2={label.y}
            stroke={label.colour}
            stroke-width="1.5"
            opacity="0.45"
          />
        )}
        {label.kind === 'kit' && (
          <>
            <circle cx={label.x} cy={label.y} r="10" fill="#ffffff" stroke={label.colour} stroke-width="2" />
            <text
              x={label.x}
              y={label.y + 4}
              text-anchor="middle"
              font-size="12"
              font-weight="700"
              fill={label.colour}>{label.text}</text>
          </>
        )}
        {label.kind === 'level' && (
          <>
            <rect
              x={label.x - label.rx}
              y={label.y - label.ry}
              width={label.rx * 2}
              height={label.ry * 2}
              rx="5"
              fill="#ffffff"
              stroke="#9aa6b8"
              stroke-width="1.5"
            />
            <text
              x={label.x}
              y={label.y + 4}
              text-anchor="middle"
              font-size="12"
              font-weight="700"
              fill="#3f4c60">{label.text}</text>
          </>
        )}
        {label.kind === 'contact' && (
          <text
            x={label.x}
            y={label.y + 4}
            text-anchor="middle"
            font-size="12"
            font-weight="700"
            paint-order="stroke"
            stroke="#ffffff"
            stroke-width="4"
            stroke-linejoin="round"
            fill={label.colour}>{label.text}</text>
        )}
      </g>
    ))}
  </svg>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  /* Framed like a plate in a manual: a thin rule, then a caption bar. */
  .board {
    margin: 0;
    border: 1px solid var(--colour-line);
    border-radius: var(--radius-l);
    background: var(--colour-page);
    overflow: hidden;
  }
  .board svg {
    width: 100%;
    height: auto;
    display: block;
    padding: 0.75rem 0.75rem 0.25rem;
  }
  .board figcaption {
    padding: 0.55rem 0.9rem;
    border-top: 1px solid var(--colour-line);
    background: var(--colour-surface);
    font-size: var(--step--1);
    font-weight: 700;
    line-height: 1.4;
    color: var(--colour-ink);
  }
</style>
