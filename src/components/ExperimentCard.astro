---
import { url } from '../lib/url';
import { experimentSlug } from '../lib/experiments';

interface Props {
  id: string;
  number: number;
  title: string;
}

const { id, number, title } = Astro.props;
---

<a class="tile" href={url(`/experiments/${experimentSlug(id)}/`)}>
  <span class="hex">{number}</span>
  <span class="title">{title}</span>
</a>

<style>
  .tile {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.7rem 1rem 0.7rem 0.7rem;
    border: 1px solid var(--colour-line);
    border-radius: var(--radius);
    background: var(--colour-page);
    text-decoration: none;
    color: var(--colour-ink-strong);
    font-weight: 600;
    line-height: 1.3;
    max-width: none;
    transition:
      border-color var(--fast) var(--ease),
      background var(--fast) var(--ease);
  }
  .tile:hover {
    border-color: var(--theme);
    background: var(--theme-wash);
  }
  .hex {
    background: var(--theme);
    transition: transform var(--fast) var(--ease);
  }
  .tile:hover .hex {
    transform: translateY(-2px);
  }
  @media (prefers-reduced-motion: reduce) {
    .tile:hover .hex {
      transform: none;
    }
  }
</style>
