---
import { cellCenter, spanOf } from '../board/geometry';
import type { PlacedPart } from '../board/describe';
import { CONTACT_LABELS, PART_COLOURS, kitBadge, symbolMarkup } from '../parts/symbols';
import { partDef } from '../parts/registry';

interface Props {
  part: PlacedPart;
}

const { part } = Astro.props;

const placement = part.at
  ? { ...cellCenter(part.at), length: 0, angle: 0 }
  : spanOf(part.from!, part.to!);

const markup = symbolMarkup(part.type, placement.length, part.flip ?? false);
const level = part.level ?? 1;

// Badges must stay upright, so they are placed outside the rotated group.
// The kit number sits beside the middle of the part, offset along the
// part's own "up" — above a horizontal part, to the side of a vertical one.
// Level badges go below-left of the part's first hole, so that the two
// kinds of badge do not pile up where parts are stacked.
const radians = (placement.angle * Math.PI) / 180;
const mid = {
  x: placement.x + (placement.length / 2) * Math.cos(radians),
  y: placement.y + (placement.length / 2) * Math.sin(radians),
};
const OFFSET = 31;
const badgeAt = {
  x: mid.x + OFFSET * Math.sin(radians),
  y: mid.y - OFFSET * Math.cos(radians),
};

const badge = kitBadge(part.type);
const contactColour = PART_COLOURS[partDef(part.type).colour];

// Contact lettering sits on the far side of the part from the kit number,
// and is placed upright for the same reason the badges are.
const contacts = (CONTACT_LABELS[part.type] ?? []).map((contact) => ({
  label: contact.label,
  x: placement.x + contact.t * placement.length * Math.cos(radians) - 30 * Math.sin(radians),
  y: placement.y + contact.t * placement.length * Math.sin(radians) + 30 * Math.cos(radians),
}));
const levelAt = cellCenter(part.at ?? part.from!);
---

<g
  transform={`translate(${placement.x} ${placement.y}) rotate(${placement.angle})`}
  set:html={markup}
/>

{badge && (
  <g transform={`translate(${badgeAt.x} ${badgeAt.y})`}>
    <circle r="10" fill="#ffffff" stroke={badge.colour} stroke-width="2" />
    <text
      x="0"
      y="4"
      text-anchor="middle"
      font-size="12"
      font-weight="700"
      fill={badge.colour}>{badge.number}</text>
  </g>
)}

{contacts.map((contact) => (
  <text
    x={contact.x}
    y={contact.y}
    text-anchor="middle"
    font-size="12"
    font-weight="700"
    paint-order="stroke"
    stroke="#ffffff"
    stroke-width="4"
    stroke-linejoin="round"
    fill={contactColour}>{contact.label}</text>
))}

{level > 1 && (
  <g transform={`translate(${levelAt.x - 24} ${levelAt.y + 24})`}>
    <rect
      x="-10"
      y="-10"
      width="20"
      height="20"
      rx="4"
      fill="#ffffff"
      stroke="#16202e"
      stroke-width="2"
    />
    <text
      x="0"
      y="6"
      text-anchor="middle"
      font-size="14"
      font-weight="700"
      fill="#16202e">{level}</text>
  </g>
)}
