---
import '../styles/tokens.css';
import '../styles/global.css';
import { asset, url } from '../lib/url';

interface Props {
  title: string;
  description?: string;
  theme?: 'red' | 'green' | 'orange' | 'blue' | 'purple';
}

const { title, description, theme = 'blue' } = Astro.props;

const links = [
  { href: url('/'), label: 'Home' },
  { href: url('/experiments/'), label: 'Experiments' },
  { href: url('/ideas/'), label: 'Ideas' },
  { href: url('/parts/'), label: 'Parts' },
  { href: url('/build-tips/'), label: 'Build tips' },
];

// Home only matches exactly; the others match their whole section.
const here = Astro.url.pathname;
const home = url('/');
const isCurrent = (href: string) =>
  href === home ? here === home : here.startsWith(href);
---

<!doctype html>
<html lang="en" data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — Easy Elektro Start</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/svg+xml" href={asset('/favicon.svg')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@100..125,400..800&display=swap"
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to the experiment</a>

    <header class="site-header">
      <div class="wrap">
        <a class="wordmark" href={url('/')}>
          Easy Elektro Start
          <span>60 experiments, in English</span>
        </a>
        <nav class="site-nav" aria-label="Main">
          {
            links.map((link) => (
              <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
                {link.label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    {/* Full-bleed chapter bands render outside the reading container. */}
    <slot name="band" />

    <main id="main" class="wrap">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <p>
          Unofficial companion site for the KOSMOS Easy Elektro Start kit. Not
          affiliated with or endorsed by Franckh-Kosmos Verlags-GmbH &amp; Co. KG.
        </p>
      </div>
    </footer>

    <script>
      import { hydrate } from '../scripts/progress';
      hydrate();
    </script>
  </body>
</html>
